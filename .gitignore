# 비밀
.env

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.hypothesis/
*.egg-info/

# 캐시
.cache/

# 수집 원천·가공 데이터 (재수집 가능, 용량 큼)
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/processed/**
!data/processed/.gitkeep

# 제출 자료 압축본
*.zip

# 예외: KOSIS 공개 집계표 원문(합성 인구 재현용, 키 미포함)과 합성 인구 메타
!data/raw/kosis/*.json
!data/processed/population_meta.json

# 시뮬레이션 상세 결과(재생성 가능)
artifacts/sim/*.parquet

# 예외: LLM 행동 응답(비용이 든 결과, 재현용)
!artifacts/sim/behavior.parquet

# Vercel CLI 로컬 설정
web/.vercel

# Vercel CLI 로컬 설정·토큰(커밋 금지)
.vercel
.env*.local

.vercel
.env*

# Hugging Face Space 배포 묶음(scripts/build_space.py 가 생성)
dist/
